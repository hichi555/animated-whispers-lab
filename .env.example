# Public Supabase client configuration
VITE_SUPABASE_URL="https://nfefwcmklegldwfjrtku.supabase.co"
VITE_SUPABASE_PROJECT_ID="nfefwcmklegldwfjrtku"
VITE_SUPABASE_PUBLISHABLE_KEY="your-public-anon-or-publishable-key"
# Optional for local development only when localhost OAuth should hand off to a hosted app.
# Production callback URLs are derived from the active CyliaTales origin.
# VITE_APP_URL="https://your-cylia-tales-host.example"

# Server-side Supabase configuration
SUPABASE_URL="https://nfefwcmklegldwfjrtku.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-public-anon-or-publishable-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# OpenAI-compatible AI gateway. Keep all secret values server-side.
OPENAI_API_KEY="your-openai-api-key"
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_TEXT_MODEL="gpt-5"

# Optional aliases for deployment platforms that standardize on AI_* names.
# AI_API_KEY="your-openai-api-key"
# AI_API_BASE="https://api.openai.com/v1"
# AI_TEXT_MODEL="gpt-5"

# Optional text provider routing. Never add VITE_ to provider secrets; VITE_ values are exposed to browser code.
# Keys stay server-side. The primary OpenAI-compatible key is used for video.
# AI_TEXT_PROVIDER=openai # openai | cloudflare | groq | pollinations; defaults to the primary key, then Cloudflare, Groq, Pollinations
# AI_TTS_MODEL="gpt-4o-mini-tts" # OpenAI-compatible speech endpoint; Pollinations is the server-side backup
# POLLINATIONS_TTS_MODEL="google/gemini-3.8-flash-tts" # WAV output; accepts CyliaTales' Gemini narrator voice IDs
# CLOUDFLARE_AI_ACCOUNT_ID="your-cloudflare-account-id" # CLOUDFLARE_ACCOUNT_ID also supported
# CLOUDFLARE_AI_API_TOKEN="your-workers-ai-api-token" # CLOUDFLARE_API_TOKEN and CLOUDFLARE_API_KEY also supported
# CLOUDFLARE_AI_TEXT_MODEL="@cf/openai/gpt-oss-120b"
# GROQ_API_KEY="your-groq-api-key"
# GROQ_TEXT_MODEL="openai/gpt-oss-120b"
# POLLINATIONS_API_KEY="your-pollinations-secret-key" # POLLINATIONS_KEY also supported; use a server secret, never a browser key
# POLLINATIONS_TEXT_MODEL="openai/gpt-5.4-nano"
# POLLINATIONS_IMAGE_MODEL="openai/gpt-image-2.5-sunburst"
# AI_IMAGE_PROVIDER=cloudflare # openai | cloudflare | pollinations; remaining configured providers are tried in order
# CLOUDFLARE_AI_IMAGE_MODEL="@cf/black-forest-labs/flux-2-klein-4b"
# OPENAI_IMAGE_MODEL="openai/gpt-image-2.5-sunburst"
# POLLINATIONS_IMAGE_EDIT_MODEL="black-forest-labs/flux.2-klein-4b"
# ElevenLabs voice cloning and narration.
ELEVENLABS_API_KEY="your-elevenlabs-api-key"

# Optional worker-backed story job processing.
# CLOUDFLARE_STORY_WORKER_URL="https://your-worker.example.com"
# CLOUDFLARE_STORY_WORKER_TOKEN="your-worker-token"
